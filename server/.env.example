PORT=3002
REQFLOW_REQUEST_LOGS=1
# local: 前端可直接传工作区/角色/操作者，适合本地开发
# trusted-header: 要求可信网关/SSO 注入 x-reqflow-actor、x-reqflow-workspace、x-reqflow-role
REQFLOW_AUTH_MODE=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 本机 OpenAI 兼容 API 示例：
# OPENAI_API_KEY=local-dev-key
# OPENAI_BASE_URL=http://127.0.0.1:你的端口/v1
# OPENAI_MODEL=你的模型名

# DeepSeek 示例：
# OPENAI_API_KEY=你的 DeepSeek API Key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-flash
